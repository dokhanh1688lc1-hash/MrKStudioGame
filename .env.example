# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit .env.
# Tất cả giá trị dưới đây là GIẢ.

# --- Nhà cung cấp AI (có thể để trống: hệ thống chạy ở chế độ nội bộ) ---
OPENAI_API_KEY=sk-fake-openai-key
ANTHROPIC_API_KEY=sk-ant-fake-anthropic-key
# Model ID do bạn tự cấu hình (hoặc qua giao diện "AI Provider & Routing")
OPENAI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Telegram (chưa triển khai ở Phase 1) ---
TELEGRAM_BOT_TOKEN=123456:fake-telegram-token

# --- Ứng dụng ---
DATABASE_URL=sqlite:///./data/mrk_studio.db
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ADMIN_USERNAME=owner
# Để trống: hệ thống tự sinh mật khẩu ngẫu nhiên và in ra console một lần
ADMIN_PASSWORD=
TOKEN_TTL_HOURS=12
